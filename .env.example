# 이 파일을 .env로 복사해서 사용합니다 (cp .env.example .env). 실제 키는 .env에만 넣으세요.

# 오픈AI API 키 입력 (로컬 모델 모드에서는 아래 '로컬 모델' 블록의 값을 사용)
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_ORG_ID=your-org-id-here  # 선택 사항. 예시 값 그대로 두면 OpenAI 호출이 실패하므로 필요할 때만 설정

# 로컬 모델 (선택 사항 - README 환경 설정 5단계). 주석을 해제하면 OpenAI 대신 로컬 모델 사용
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen3.8-27b
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=BAAI/bge-m3

# 랭스미스 설정 (선택 사항 - 트레이스 및 모니터링)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=your-project-name

# 5장 전용 설정
WOLFRAM_ALPHA_APP_ID=wolfram-app-id
YOUR_SLACK_BOT_TOKEN=slack-bot-token

# 트레이스루프 (8~11장). 키를 비워 두고 BASE_URL을 지정하면 로컬 Tempo로 전송 (README 환경 설정 6단계)
TRACELOOP_API_KEY=
TRACELOOP_BASE_URL=http://localhost:4318
TRACELOOP_METRICS_ENABLED=false
